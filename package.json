{
  "name": "dsh-breeze-tts",
  "description": "Breeze TTS for DeepSeek Harness: AI auto-read (local runtime) plus voice workshop (design/clone/manage voices)",
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "icon": "icon.png",
  "files": [
    "lib/",
    "README.md",
    "README-AI.md",
    "AI_SETUP.md",
    "NOTICE.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OldQin-Aurora001/dsh-breeze-tts.git"
  },
  "keywords": [
    "dsh-plugin",
    "tts",
    "breeze",
    "voice",
    "speech",
    "text-to-speech"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.1.1-rc.0 || ^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
